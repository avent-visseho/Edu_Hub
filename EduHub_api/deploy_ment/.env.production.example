# EduHub — configuration de production
#
# Copiez ce fichier en .env.production, remplacez chaque CHANGEZ_MOI, et ne le
# versionnez jamais : il contient la clé de signature des jetons et le mot de
# passe de la base.
#
# ATTENTION AU PRÉFIXE. L'application lit ses réglages avec le préfixe EDUHUB_
# (app/core/config.py, env_prefix="EDUHUB_"). Une variable DATABASE_URL sans
# préfixe serait ignorée sans le moindre message : l'API démarrerait sur la
# base par défaut « localhost » et échouerait à la première requête.

# ---------- Application ----------
EDUHUB_ENVIRONMENT=production
EDUHUB_DEBUG=false
# Nombre de processus uvicorn. Deux suffisent pour une démonstration.
EDUHUB_WORKERS=2

# ---------- Sécurité ----------
# Au moins 32 caractères aléatoires. Générez-la avec :
#   openssl rand -hex 32
# La changer invalide tous les jetons en circulation.
EDUHUB_SECRET_KEY=CHANGEZ_MOI_openssl_rand_hex_32
EDUHUB_ACCESS_TOKEN_EXPIRE_MINUTES=60
EDUHUB_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- Base de données ----------
# Le nom d'hôte « db » est celui du service dans docker-compose.prod.yml.
# Le mot de passe doit être identique à EDUHUB_DB_PASSWORD ci-dessous.
EDUHUB_DATABASE_URL=postgresql+asyncpg://eduhub:CHANGEZ_MOI_mot_de_passe@db:5432/eduhub
EDUHUB_DATABASE_ECHO=false
# Le serveur héberge plusieurs PostgreSQL : on reste modeste sur le pool.
EDUHUB_DATABASE_POOL_SIZE=10
EDUHUB_DATABASE_MAX_OVERFLOW=5

# Reprises par docker-compose pour créer le conteneur PostgreSQL.
EDUHUB_DB_USER=eduhub
EDUHUB_DB_PASSWORD=CHANGEZ_MOI_mot_de_passe
EDUHUB_DB_NAME=eduhub

# ---------- Nom de domaine ----------
# Sous-domaine derrière lequel nginx publie l'API en HTTPS. Sert à
# configurer-nginx.sh et au certificat Let's Encrypt.
#
# L'enregistrement A doit pointer vers le serveur :
#   eduhub.ezafri.com  A  185.194.217.12
EDUHUB_DOMAINE=eduhub.ezafri.com

# ---------- Port publié sur le serveur ----------
# Publié sur 127.0.0.1 uniquement : seul nginx s'y adresse. 8000 est occupé par
# swiftlink, 8080 par lokahome, 3000/3001/4000/5050/5433 et 9000-9001 par vos
# autres projets.
EDUHUB_PORT=8100

# ---------- Origines autorisées ----------
# Liste séparée par des virgules. Sans l'origine exacte du front, le navigateur
# bloquera les appels — et il exige le schéma, sans barre oblique finale.
# Remplacez l'URL Vercel par la vôtre dès qu'elle est connue ; ajoutez les URL
# de prévisualisation si vous voulez les faire fonctionner aussi.
EDUHUB_CORS_ORIGINS=http://localhost:3000,https://CHANGEZ_MOI.vercel.app

# ---------- Stockage des pièces jointes ----------
# Sans S3 joignable, le moteur de stockage bascule sur le disque local, monté
# sur le volume eduhub_storage. Rien d'autre à configurer.
EDUHUB_STORAGE_LOCAL_FALLBACK=/app/storage

# ---------- Jeu de démonstration ----------
# tiny | small | medium | large — volume des données générées par le seed.
EDUHUB_SEED_SCALE=medium
EDUHUB_SEED_RANDOM_SEED=2026
