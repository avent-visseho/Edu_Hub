# ---------- Application ----------
EDUHUB_ENVIRONMENT=development
EDUHUB_DEBUG=true
EDUHUB_PROJECT_NAME=EduHub
EDUHUB_API_V1_PREFIX=/api/v1

# ---------- Sécurité ----------
EDUHUB_SECRET_KEY=change-me-in-production-0000000000000000
EDUHUB_ACCESS_TOKEN_EXPIRE_MINUTES=60
EDUHUB_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- Base de données ----------
EDUHUB_DATABASE_URL=postgresql+asyncpg://eduhub:eduhub@localhost:5442/eduhub

# ---------- Redis ----------
EDUHUB_REDIS_URL=redis://localhost:6389/0

# ---------- Stockage objet (MinIO / S3) ----------
EDUHUB_S3_ENDPOINT_URL=http://localhost:9010
EDUHUB_S3_ACCESS_KEY=eduhub
EDUHUB_S3_SECRET_KEY=eduhub123
EDUHUB_S3_BUCKET=eduhub
EDUHUB_S3_REGION=us-east-1

# ---------- CORS ----------
EDUHUB_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Simulation ----------
EDUHUB_SEED_SCALE=medium
EDUHUB_SEED_RANDOM_SEED=2026
